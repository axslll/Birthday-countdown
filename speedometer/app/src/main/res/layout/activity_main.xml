<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/surface_bg"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/unitKmh"
                    style="@style/Segment"
                    android:text="km/h" />

                <TextView
                    android:id="@+id/unitMph"
                    style="@style/Segment"
                    android:text="mph" />
            </LinearLayout>
        </RelativeLayout>

        <com.example.speedometer.SpeedometerView
            android:id="@+id/speedometer"
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:layout_marginTop="8dp" />

        <!-- trip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/surface_bg"
            android:orientation="horizontal">

            <include android:id="@+id/cellMax" layout="@layout/stat_cell" />
            <include android:id="@+id/cellAvg" layout="@layout/stat_cell" />
            <include android:id="@+id/cellDist" layout="@layout/stat_cell" />
        </LinearLayout>

        <TextView
            android:id="@+id/resetTrip"
            style="@style/Label"
            android:layout_gravity="end"
            android:padding="10dp"
            android:text="Reset trip" />

        <!-- satellites -->
        <TextView
            style="@style/Label"
            android:layout_marginTop="14dp"
            android:text="Satellites" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/surface_bg"
            android:orientation="horizontal">

            <include android:id="@+id/cellUsed" layout="@layout/stat_cell" />
            <include android:id="@+id/cellView" layout="@layout/stat_cell" />
            <include android:id="@+id/cellCn0" layout="@layout/stat_cell" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/surface_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/Label"
                    android:text="Signal strength" />

                <TextView
                    android:id="@+id/signalQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </RelativeLayout>

            <com.example.speedometer.MeterView
                android:id="@+id/signalMeter"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:id="@+id/constellations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
